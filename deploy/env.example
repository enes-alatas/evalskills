# Zone A (this app container) takes no credentials: no model keys, no provider settings (ADR-0002, ADR-0004).
# The public service runs static Tier 1 only. A model key lives only in the zone B gateway, delivered as a mounted
# file, and LLM-backed checks would reach it through the gateway with a per-run token, under its own ADR.
# Tier 3 is not enabled on the shared VPS (see docs/HOSTING.md).
MAX_QUEUE=100
MAX_SKILLS_PER_SUBMISSION=10
# Clone cache bound: clones unused this long are deleted, and at most this many are kept (x 300 MB each).
CACHE_MAX_AGE_HOURS=6
CACHE_MAX_REPOS=40
# Stored evaluations bound (#168): each skill keeps the report folders of its newest few evaluations (and of the
# result the site shows), and nothing is evaluated while the data volume has less than this many bytes free.
REPORTS_KEPT_PER_SKILL=3
MIN_FREE_DATA_BYTES=5368709120
# Connection bounds (#171): a connection that sends nothing for REQUEST_TIMEOUT_S seconds is closed, and so is one
# whose request isn't fully in by REQUEST_DEADLINE_S. At most MAX_CONNECTIONS are served at once (the rest are
# closed on arrival), and at most MAX_CONNECTIONS_PER_CLIENT requests with a body per client (the next gets 429 before its body is
# read; GETs never count).
REQUEST_TIMEOUT_S=30
REQUEST_DEADLINE_S=60
MAX_CONNECTIONS=64
MAX_CONNECTIONS_PER_CLIENT=4
SUBMISSIONS_PER_HOUR=20
DISCOVERIES_PER_HOUR=30
# Site-wide GitHub repository lookups an hour, cached answers aside. Keep it well under the 5,000 an hour of the
# account that owns the lookup token: that account's other work shares them (#167).
LOOKUPS_PER_HOUR=2000
# Seconds per Tier 1 scan; the app and the scanner both read it. SkillSpector's own deadlines are 70% and 80% of it,
# so a slow scan ends with Security Scan incomplete rather than no report (#112).
TIER1_TIMEOUT=900
# GitHub mark in the header, linking to the project's source. Leave unset to hide it (e.g. while the repo is private).
#SOURCE_REPO_URL=https://github.com/enes-alatas/evalskills
# Networking (optional; the defaults suit a host whose Caddy runs as a system daemon). The app is published on
# 127.0.0.1:EVALSKILLS_PORT only, and trusts X-Forwarded-For only from EVALSKILLS_GATEWAY, the gateway of its own
# bridge network, which compose sets as TRUSTED_PROXIES. Change the subnet only if it collides with a network on the
# host, and keep the gateway inside it. Never inside 172.31.240.0/20: that range belongs to the eval daemon and its
# firewall (deploy/gvisor/), which drops all but model-gateway traffic from it.
#EVALSKILLS_PORT=8088
#EVALSKILLS_SUBNET=172.30.250.0/24
#EVALSKILLS_GATEWAY=172.30.250.1
TRUSTED_PROXY_HOPS=1
