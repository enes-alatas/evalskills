# Provider for LLM-backed checks and Tier 3 (leave unset for static-only Tier 1).
# SKILL_EVAL_LLM_PROVIDER=nv_build
# NVIDIA_API_KEY=            # from build.nvidia.com; never commit a real value
# Tier 3 is not enabled on the shared VPS (see docs/HOSTING.md).
MAX_QUEUE=100
MAX_SKILLS_PER_SUBMISSION=10
SUBMISSIONS_PER_HOUR=20
DISCOVERIES_PER_HOUR=30
TIER1_TIMEOUT=600
