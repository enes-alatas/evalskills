# Zone A (this app container) takes no credentials: no model keys, no provider settings (ADR-0002, ADR-0004).
# The public service runs static Tier 1 only. A model key lives only in the zone B gateway, delivered as a mounted
# file, and LLM-backed checks would reach it through the gateway with a per-run token, under its own ADR.
# Tier 3 is not enabled on the shared VPS (see docs/HOSTING.md).
MAX_QUEUE=100
MAX_SKILLS_PER_SUBMISSION=10
# Clone cache bound: clones unused this long are deleted, and at most this many are kept (x 300 MB each).
CACHE_MAX_AGE_HOURS=6
CACHE_MAX_REPOS=40
SUBMISSIONS_PER_HOUR=20
DISCOVERIES_PER_HOUR=30
TIER1_TIMEOUT=600
